---
layout: layout.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/categories/{{ category.id }}/index.html"
---

<a href="/" class="back-link">← Home</a>

<h1>Trainings in {{ category.name.en }}</h1>
<p>{{ category.description.en }}</p>

<div class="training-grid">
{% for training in trainings %}
    {% if training.categories.includes(category.id) %}
    <div class="training-card">
        {% if training.featured %}
        <span class="featured-badge">Featured</span>
        {% endif %}
        <h3>{{ training.title.en }}</h3>
        <p>{{ training.description.en }}</p>
        <div class="training-meta">
            <span class="meta-item">⏱️ {{ training.duration.en }}</span>
            <span class="meta-item">📊 {{ training.level.en }}</span>
        </div>
        <a href="/trainings/{{ training.id }}/" class="btn">View Details</a>
    </div>
    {% endif %}
{% endfor %}
</div>
